# ─── Step 1: Database (Neon) ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ─── Step 2: Auth (Better Auth) ───────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Step 3: Stripe (test keys from dashboard.stripe.com/test/apikeys) ────
STRIPE_SECRET_KEY=sk_test_...
# Local: run `npm run stripe:listen` and paste whsec_... from output
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Step 5: Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
# Dev/test: onboarding@resend.dev | Production: noreply@yourdomain.com (verified)
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=you@yourdomain.com

# Test: npm run email:test
# Admin: ADMIN_EMAIL=you@domain.com npm run promote-admin

# ─── Site URL (local dev) ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
